# ==============================================================================
# ENTERPRISE AGENTIC RAG - ENVIRONMENT CONFIGURATION
# Copy to .env and fill in. Every value is read at startup; nothing here is
# required except API_KEYS when APP_ENV=production.
# ==============================================================================

# ------------------------------------------------------------------- Runtime
APP_ENV=development            # development | staging | production
LOG_LEVEL=INFO
LOG_JSON=true                  # false for human-readable local logs
DEBUG=false

# ---------------------------------------------------------------------- Auth
# Authentication is always on unless you explicitly turn it off, and turning it
# off is refused when APP_ENV=production.
AUTH_ENABLED=true
# "key:role1,role2" entries separated by "|". Send the key as X-API-Key.
# Generate with: python -c "import secrets;print(secrets.token_urlsafe(32))"
API_KEYS=
# Roles allowed to ingest or delete documents.
WRITE_ROLES=admin,engineer
# Roles granted to unauthenticated callers when AUTH_ENABLED=false (never in prod).
DEV_ANONYMOUS_ROLES=admin,public

# -------------------------------------------------------------------- Limits
# Comma-separated browser origins allowed by CORS. Empty = same-origin only.
ALLOWED_ORIGINS=http://localhost:8000
RATE_LIMIT_PER_MINUTE=60
MAX_UPLOAD_MB=25
MAX_QUERY_CHARS=4000
ALLOWED_UPLOAD_EXTENSIONS=.pdf,.docx,.md,.markdown,.txt,.rst

# ---------------------------------------------------------------- Generation
GROQ_API_KEY=
GROQ_BASE_URL=https://api.groq.com/openai/v1
GROQ_MODEL=openai/gpt-oss-120b
GROQ_FAST_MODEL=openai/gpt-oss-20b

OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4o
CRITIC_MODEL=gpt-4o-mini
EMBEDDING_MODEL=text-embedding-3-large
EMBEDDING_DIM=1536

LLM_TIMEOUT_SECONDS=60
LLM_MAX_RETRIES=2
LLM_MAX_BACKOFF_SECONDS=20
# Optional cost accounting, in USD per 1K tokens, for /api/v1/admin/usage.
LLM_INPUT_COST_PER_1K=0
LLM_OUTPUT_COST_PER_1K=0

# ------------------------------------------------------------------- Storage
STORAGE_DIR=data/storage
# The index is per-process. Leave false unless you replace it with a shared store.
ALLOW_MULTI_WORKER=false

# -------------------------------------------------------- External stores (optional)
# Unset means the in-process implementations are used.
VECTOR_STORE_URI=
GRAPH_STORE_URI=
GRAPH_USER=
GRAPH_PASSWORD=
OPENSEARCH_URI=
REDIS_URI=

# ------------------------------------------------------- Search & Retrieval
TOP_K_RETRIEVAL=15
TOP_K_RERANK=5
RRF_K=60
RERANKER_CONFIDENCE_THRESHOLD=0.35

# -------------------------------------------------------- Verification Loop
MAX_VERIFICATION_RETRIES=2
FAITHFULNESS_THRESHOLD=0.85
RETRIEVAL_TIMEOUT_MS=400
MAX_CONTEXT_TOKENS=3000
